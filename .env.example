# ─────────────────────────────────────────────────
# Database (external/cloud Postgres — NOT in Docker)
# ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@your-cloud-host:5432/mydb?schema=public"

# ─────────────────────────────────────────────────
# Redis (Docker container on same server)
# ─────────────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ─────────────────────────────────────────────────
# App Ports
# ─────────────────────────────────────────────────
PORT=3000
WS_PORT=3001

# ─────────────────────────────────────────────────
# CORS (your frontend origin)
# ─────────────────────────────────────────────────
CORS_ORIGIN="https://your-frontend.com"

# ─────────────────────────────────────────────────
# Email (Gmail SMTP — use App Password)
# Generate at: https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────
MY_EMAIL="your-email@gmail.com"
GMAIL_PASSWORD="your-gmail-app-password"
